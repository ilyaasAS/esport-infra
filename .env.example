# Copier vers `.env` à la racine (utilisé par docker compose pour interpoler ${DB_ROOT_PASSWORD}).
# Ne duplique pas JWT_SECRET ici : les secrets Spring sont dans backend/.env (voir README.md racine).
# DB_ROOT_PASSWORD = mot de passe root MySQL ; le service backend reçoit DB_PASSWORD identique via compose.

DB_ROOT_PASSWORD=changeme_secure_password
