# Copier vers `.env` à la racine (utilisé par docker compose).
# Ne pas mettre ici JWT_SECRET / ADMIN_PASSWORD : ces secrets applicatifs vivent dans backend/.env.

# Mot de passe root MySQL (administration interne uniquement, jamais utilisé par l'application).
DB_ROOT_PASSWORD=changeme_root_password

# Utilisateur applicatif dédié (moindre privilège), limité à la base esport_db.
# Le backend se connecte avec ce compte (jamais root).
DB_APP_USER=esport_app
DB_APP_PASSWORD=changeme_app_password

# Modèle IA : "llama3.2:1b" pour mode CPU ultra-rapide (faible conso CPU sous Docker)
OLLAMA_MODEL=llama3.2:1b

# URL d'Ollama :
# - Par défaut (moteur Ollama conteneurisé) : http://ollama:11434
# - Pour basculer vers un Ollama natif macOS hôte avec accélération GPU Metal :
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Observabilité & Traçabilité LLM (Langfuse / OpenTelemetry)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_AUTH_HEADER=Basic <base64_encoded_public_key:secret_key>

